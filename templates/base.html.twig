<!DOCTYPE html>
<html>

<head>
  <link rel="icon" href="{{ asset('image/moi.jpg') }}" type="image/jpeg">
  <meta charset="UTF-8">
  <title>{% block title %}Welcome!{% endblock %}</title>
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
  
  {% block stylesheets %}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
  {% endblock %}

  {% block javascripts %}
  {% block importmap %}{{ importmap('app') }}{% endblock %}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
  {% endblock %}

  {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
  {% if frankenphp_hot_reload %}
  <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
  <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
  <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
  {% endif %}
</head>

<body>
  <style>
    @keyframes colorChange {
        0% { background-color: rgb(248, 250, 252); }
        33% { background-color: rgb(238, 242, 255); }
        66% { background-color: rgb(240, 253, 250); }
        100% { background-color: rgb(248, 250, 252); }
    }

    html {
        height: 100%;
        margin: 0;
    }

    body {
        min-height: 100vh; /* S'assure que le body prend au moins toute la hauteur de l'écran */
        margin: 0;
        animation: colorChange 15s ease infinite !important;
        color: #1e293b;
    }
    
    .bento-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .bento-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -8px rgba(79, 70, 229, 0.18) !important;
        border-color: #a5b4fc;
    }

    .bento-card-dark {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        border: 1px solid #312e81;
        border-radius: 1.25rem;
    }

    .text-indigo { color: #4f46e5; }
    .bg-indigo { background-color: #4f46e5; color: white; }
    .btn-indigo { 
        background-color: #4f46e5; 
        color: white; 
        border: none;
        border-radius: 0.75rem;
    }
    .btn-indigo:hover { 
        background-color: #4338ca; 
        color: white; 
    }

    /* === ANIMATIONS D'APPARITION (FADE IN UP) === */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-bento {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 0.5s; }
    .delay-6 { animation-delay: 0.6s; }
    .delay-7 { animation-delay: 0.7s; }
    .delay-8 { animation-delay: 0.8s; }

    .navbar {
      background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%) !important;
      padding-top: 1rem;
      padding-bottom: 1rem;
      box-shadow: 0 4px 20px -5px rgba(79, 70, 229, 0.25);
    }

    .navbar .navbar-brand {
      font-size: 1.25rem !important;
      font-weight: bold;
      color: #ffffff !important;
    }

    .navbar-nav .nav-link {
      font-size: 1.1rem !important;
      color: rgba(255, 255, 255, 0.8) !important;
      transition: color 0.2s ease-in-out, transform 0.2s ease-in-out;
    }

    /* Effet de survol des catégories de la navbar */
    .navbar-nav .nav-link:hover,
    .navbar-nav .nav-link:focus {
      color: #ffffff !important;
      transform: translateY(-1px);
    }

    .dropdown-menu {
      border-radius: 1rem;
      border: 1px solid #e2e8f0;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .dropdown-menu .dropdown-item {
      font-size: 1rem !important;
      border-radius: 0.5rem;
      margin: 0.2rem;
    }
  </style>

  <!-- Barre de navigation globale placée dans le body -->
  <nav class="navbar navbar-expand-lg mb-4">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
      <img src="/image/moi.jpg" alt="MOI" width="75" height="100" style="border-radius: 0.5rem;"></a>
      <a class="navbar-brand" href="/">Portfolio</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Projets
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/cyberquiz" >Cyberquiz</a></li>
              <li><a class="dropdown-item" href="/FirstDigitalSteps">FirstDigitalSteps</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              A propos de moi
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/cv">CV</a></li>
              <li><a class="dropdown-item" href="/PP">Projet professionnel</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/vt">Veille technologique</a>
          </li>
        </ul>
        <form class="d-flex" role="search">
          <input class="form-control me-2 border-0 shadow-sm" type="search" placeholder="Recherche..." />
          <button class="btn btn-light text-indigo fw-semibold px-3 shadow-sm" type="submit">Recherche</button>
        </form>
      </div>
    </div>
  </nav>

  <!-- Contenu spécifique de chaque page -->
  <div class="container">
    {% block body %}{% endblock %}
  </div>
</body>

</html>
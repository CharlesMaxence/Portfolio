<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>{% block title %}Welcome!{% endblock %}</title>
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
  
  {% block stylesheets %}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
  {% endblock %}

  {% block javascripts %}
  {% block importmap %}{{ importmap('app') }}{% endblock %}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
  {% endblock %}

  {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
  {% if frankenphp_hot_reload %}
  <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
  <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
  <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
  {% endif %}
</head>

<body>
  <style>
    .navbar {
    background-color: rgb(67, 67, 255) !important;
    /* Ajustez ces valeurs pour rendre la navbar plus ou moins épaisse */
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  /* Pour grossir un peu le texte et le centrer parfaitement avec la nouvelle épaisseur */
  .navbar .navbar-brand,
  .navbar .nav-link {
    font-size: 1rem;
  }
  .navbar-brand {
        font-size: 1.25rem !important; /* Vous pouvez augmenter (ex: 1.5rem) */
        font-weight: bold;
    }

    /* Agrandit le texte des liens et des menus déroulants */
    .navbar-nav .nav-link {
        font-size: 1.1rem !important; /* Ajustez la taille selon vos préférences */
    }

    /* Agrandit le texte des items à l'intérieur des menus déroulants */
    .dropdown-menu .dropdown-item {
        font-size: 1rem !important;
    }
  </style>
  <!-- Barre de navigation globale placée dans le body -->
  <nav class="navbar navbar-expand-lg bg-body-tertiary mb-4">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
      {#<marquee><img src="/image/moi.jpg" alt="MOI" width="900" height="100"></marquee> funny XD#}
      <img src="/image/moi.jpg" alt="MOI" width="75" height="100">
      <a class="navbar-brand" href="/">Portfolio</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Projets
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/Cyberquiz" >Cyberquiz</a></li>
              <li><a class="dropdown-item" href="/FirstDigitalSteps">FirstDigitalSteps</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              A propos de moi
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/cv">CV</a></li>
              <li><a class="dropdown-item" href="/PP">Projet professionnel</a></li>
            </ul>
          </li>
        </ul>
        <form class="d-flex" role="search">
          <input class="form-control me-2" type="search" placeholder="Recherche" />
          <button class="btn btn-outline-success" type="submit">Recherche</button>
        </form>
      </div>
    </div>
  </nav>

  <!-- Contenu spécifique de chaque page -->
  <div class="container">
    {% block body %}{% endblock %}
  </div>
</body>

</html>
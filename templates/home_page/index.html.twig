{% extends 'base.html.twig' %}

{% block title %}Mon Portfolio - Accueil{% endblock %}

{% block body %}
<!-- Arrière-plan personnalisé et animations d'apparition -->
<style>
    body {
        background-color: rgb(248, 250, 252);
        color: #1e293b;
    }
    
    .bento-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .bento-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -10px rgba(79, 70, 229, 0.15) !important;
        border-color: #cbd5e1;
    }

    .bento-card-dark {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        border: 1px solid #312e81;
        border-radius: 1.25rem;
    }

    .text-indigo { color: #4f46e5; }
    .bg-indigo { background-color: #4f46e5; color: white; }
    .btn-indigo { 
        background-color: #4f46e5; 
        color: white; 
        border: none;
        border-radius: 0.75rem;
    }
    .btn-indigo:hover { 
        background-color: #4338ca; 
        color: white; 
    }

    /* === ANIMATIONS D'APPARITION (FADE IN UP) === */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-bento {
        opacity: 0; /* Caché au départ */
        animation: fadeInUp 0.8s ease-out forwards;
    }

    /* Décalages en cascade pour chaque bloc */
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 0.5s; }
    .delay-6 { animation-delay: 0.6s; }
    .delay-7 { animation-delay: 0.7s; }
    .delay-8 { animation-delay: 0.8s; }
</style>

<div class="container py-5">
    <div class="text-center mb-5 animate-bento delay-1">
        <h1 class="fw-bold display-5 text-indigo">Bienvenue sur mon Portfolio</h1>
        <p class="text-muted fs-5">Étudiant en BTS SIO option SLAM & Développeur passionné</p>
    </div>

    <div class="row g-4">
        
        <!-- À propos -->
        <div class="col-lg-8 animate-bento delay-2">
            <div class="p-4 h-100 bento-card shadow-sm d-flex flex-column justify-content-between">
                <div>
                    <span class="badge bg-indigo px-3 py-2 rounded-pill mb-3">À propos de moi</span>
                    <h3 class="fw-bold">Maxence Charles</h3>
                    <p class="text-secondary mt-3 fs-5">
                        Actuellement en BTS SIO (Services informatiques aux organisations) option SLAM et en parallèle à l'ISEN Ouest. Je recherche un stage de développement du 18 janvier au 20 février 2027.
                    </p>
                </div>
                <div class="mt-4">
                    <a href="/cv" class="btn btn-indigo px-4 py-2">Voir mon CV &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Contact -->
        <div class="col-lg-4 animate-bento delay-3">
            <div class="p-4 h-100 bento-card-dark text-white shadow-sm d-flex flex-column justify-content-between">
                <div>
                    <span class="badge bg-white text-dark px-3 py-2 rounded-pill mb-3">Contact</span>
                    <h4 class="fw-bold">Restons connectés</h4>
                    <p class="text-light opacity-75 mt-3">N'hésitez pas à me contacter pour une opportunité de stage ou un projet.</p>
                </div>
                <div class="mt-4">
                    <a href="mailto:mxch71700@gmail.com" class="btn btn-light btn-lg w-100 rounded-3 text-indigo fw-semibold fs-6">Me contacter par email</a>
                </div>
            </div>
        </div>

        <!-- Projet 1 -->
        <div class="col-lg-4 animate-bento delay-4">
            <div class="p-4 h-100 bento-card shadow-sm">
                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill mb-3">Projet</span>
                <h4 class="fw-bold">Cyberquiz</h4>
                <p class="text-secondary small mt-2">Plateforme de quiz axée sur la sensibilisation à la cybersécurité.</p>
                <a href="/Cyberquiz" class="text-decoration-none fw-bold text-indigo small">Découvrir le projet &rarr;</a>
            </div>
        </div>

        <!-- Projet 2 -->
        <div class="col-lg-4 animate-bento delay-5">
            <div class="p-4 h-100 bento-card shadow-sm">
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill mb-3">Projet</span>
                <h4 class="fw-bold">FirstDigitalSteps</h4>
                <p class="text-secondary small mt-2">Application web de développement et d'accompagnement numérique.</p>
                <a href="/FirstDigitalSteps" class="text-decoration-none fw-bold text-success small">Découvrir le projet &rarr;</a>
            </div>
        </div>

        <!-- Compétences -->
        <div class="col-lg-4 animate-bento delay-6">
            <div class="p-4 h-100 bento-card shadow-sm">
                <span class="badge bg-purple bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-3">Compétences</span>
                <h4 class="fw-bold">Technologies</h4>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <span class="badge bg-light text-dark border px-3 py-2">PHP / Symfony</span>
                    <span class="badge bg-light text-dark border px-3 py-2">JavaScript</span>
                    <span class="badge bg-light text-dark border px-3 py-2">C#</span>
                    <span class="badge bg-light text-dark border px-3 py-2">Python</span>
                    <span class="badge bg-light text-dark border px-3 py-2">SQL</span>
                </div>
            </div>
        </div>
        
    </div>
</div>

<div class="container py-5">
    <div class="text-center mb-5 animate-bento delay-7">
        <h2 class="fw-bold text-indigo">Certification / Diplôme</h2>
    </div>

    <div class="row g-4 align-items-stretch">
        
        <div class="col-lg-3 animate-bento delay-8">
            <div class="p-4 h-100 bento-card shadow-sm">
                <h4 class="fw-bold fs-5"><center>Diplôme national du brevet (DNB)</center></h4>
                <p class="text-secondary small mt-2"><center>Obtenu durant l'année 2020-2021</center></p>
            </div>
        </div>

        <div class="col-lg-6 animate-bento delay-8">
            <div class="p-4 h-100 bento-card shadow-sm d-flex flex-column">
                <h4 class="fw-bold fs-5 mb-3"><center>Certification PIX</center></h4>
                <div style="flex-grow: 1; min-height: 200px;">
                    <iframe src="{{ asset('image/pix.pdf') }}" width="100%" height="100%" style="border: none;"></iframe>
                </div>
            </div>
        </div>

        <div class="col-lg-3 animate-bento delay-8">
            <div class="p-4 h-100 bento-card shadow-sm">
                <h4 class="fw-bold fs-5"><center>Baccalauréat technologique (BAC)</center></h4>
                <p class="text-secondary small mt-2"><center>Obtenu durant l'année 2023-2024</center></p>
            </div>
        </div>

    </div>
</div>
{% endblock %}
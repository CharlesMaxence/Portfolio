{% extends 'base.html.twig' %}

{% block title %}Veille Technologique{% endblock %}

{% block body %}
<style>
    body {
        background-color: rgb(248, 250, 252);
        color: #1e293b;
    }
    
    .bento-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .bento-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -10px rgba(79, 70, 229, 0.15) !important;
        border-color: #cbd5e1;
    }

    .bento-card-dark {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        border: 1px solid #312e81;
        border-radius: 1.25rem;
    }

    .text-indigo { color: #4f46e5; }
    .bg-indigo { background-color: #4f46e5; color: white; }
    .btn-indigo { 
        background-color: #4f46e5; 
        color: white; 
        border: none;
        border-radius: 0.75rem;
    }
    .btn-indigo:hover { 
        background-color: #4338ca; 
        color: white; 
    }
</style>
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-indigo">Veille Technologique</h1>
        <p class="text-secondary fs-5">Actualités et innovations du développement web et de la tech</p>
    </div>

    <div class="row g-4">
    {% for article in articles %}
        <div class="col-lg-4">
            <div class="p-4 h-100 bento-card shadow-sm d-flex flex-column justify-content-between">
                <div>
                    <span class="badge bg-indigo mb-2">Actu Tech</span>
                    <h5 class="fw-bold fs-6">{{ article.title }}</h5>
                    <p class="text-secondary small mt-2">
                        {{ article.description|striptags|slice(0, 120) }}...
                    </p>
                </div>
                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">{{ article.date|date('d/m/Y') }}</small>
                    <a href="{{ article.link }}" target="_blank" class="text-decoration-none fw-bold text-indigo small">
                        Lire l'article &rarr;
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center">
            <p class="text-muted">Impossible de charger les flux d'actualités pour le moment.</p>
        </div>
    {% endfor %}
</div>
</div>
{% endblock %}
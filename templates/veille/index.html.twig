{% extends 'base.html.twig' %}

{% block title %}Portfolio - Veille Technologique{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-indigo">Veille Technologique</h1>
        <p class="text-secondary fs-5">Actualités et innovations du développement web et de l'IA de la part de <a href="https://www.developpez.com">developpez.com</a></p>
    </div>

    <div class="row g-4">
    {% set placeholderImage = asset('image/veille-placeholder.svg') %}
    {% for article in articles %}
        <div class="col-lg-4">
            <div class="p-4 h-100 bento-card shadow-sm d-flex flex-column justify-content-between">
                <div>
                    <img
                        src="{{ placeholderImage }}"
                        alt="Illustration : {{ article.title }}"
                        class="w-100 rounded-3 mb-3"
                        style="aspect-ratio: 16 / 9; object-fit: cover;"
                        loading="lazy"
                        decoding="async"
                        onerror="this.onerror=null;this.src='{{ placeholderImage }}';"
                    >
                    <span class="badge bg-indigo mb-2">Actu Tech</span>
                    <h5 class="fw-bold fs-6">{{ article.title }}</h5>
                    <p class="text-secondary small mt-2">
                        {{ article.description|striptags|slice(0, 120) }}...
                    </p>
                </div>
                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">{{ article.date|date('d/m/Y') }}</small>
                    <a href="{{ article.link }}" target="_blank" class="text-decoration-none fw-bold text-indigo small">
                        Lire l'article &rarr;
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center">
            <p class="text-muted">Impossible de charger les flux d'actualités pour le moment.</p>
        </div>
    {% endfor %}
</div>
</div>
{% endblock %}